# SafePay AI Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (Leave empty or set to embedded for @electric-sql/pglite in-process Postgres)
DATABASE_URL=
USE_EMBEDDED_POSTGRES=true

# Security & Secrets
ACTION_SIGNING_SECRET=safepay_dev_action_signing_secret_994827419
JWT_SECRET=safepay_jwt_secret_dev_38291048201

# Financial Policy Limits (in INR)
LIMIT_NORMAL_MAX=5000
LIMIT_NEW_RECIPIENT_MAX=3000
LIMIT_HIGH_VALUE_THRESHOLD=20000

# AI Model Configuration
PRIMARY_PROVIDER=mock
FALLBACK_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_SIMULATE_OFFLINE=false

# Metrics & Logging
ENABLE_AUDIT_VERIFICATION_ON_BOOT=true
METRICS_PORT=5000
